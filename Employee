public class Employee implements Payable {
    private int registrationNumber;
    private String name;
    private int salaryPerMonth;
    private Invoice[] invoices;

    public Employee(int registrationNumber, String name, int salaryPerMonth, Invoice[] invoices) {
        this.registrationNumber = registrationNumber;
        this.name = name;
        this.salaryPerMonth = salaryPerMonth;
        this.invoices = invoices;
    }

    @Override
    public int getPayableAmount() {
        int totalBelanja = 0;
        for (Invoice invoice : invoices) {
            totalBelanja += invoice.getPayableAmount();
        }
        return salaryPerMonth - totalBelanja;
    }

    public void printEmployeeInfo() {
        System.out.println("Nomor Registrasi : " + registrationNumber);
        System.out.println("Nama             : " + name);
        System.out.println("Gaji Bulanan     : " + salaryPerMonth);

        System.out.println("\n--- Detail Belanjaan---");
        for (Payable p : invoices) {
            if (p instanceof Invoice) {
                ((Invoice) p).printInfo();
                System.out.println();
            }
        }

        System.out.println("Gaji Setelah Potongan: " + getPayableAmount());
    }
}
